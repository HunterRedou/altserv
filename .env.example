# Copy to .env and fill in real values. Never commit .env.
DB_URL=postgres://user:password@localhost:5432/altserv?sslmode=disable
PLATFORM=dev
PORT=8080
# Go duration syntax. Default 24h, maximum 720h (30 days).
SESSION_DURATION=24h

# AES-256-GCM key for patient PII. Must decode to exactly 32 bytes.
# Generate with: openssl rand -base64 32
PATIENT_ENCRYPTION_KEY=replace-with-32-byte-base64-key
PATIENT_KEY_VERSION=1

# Separate HMAC-SHA256 key for the protected patient search index. Must decode
# to exactly 32 bytes and must differ from PATIENT_ENCRYPTION_KEY.
# Generate with: openssl rand -base64 32
PATIENT_SEARCH_KEY=replace-with-a-different-32-byte-base64-key
PATIENT_SEARCH_KEY_VERSION=1

# Optional: AES-256-GCM key for TOTP seeds. Must decode to exactly 32 bytes and
# must differ from the patient and search keys. When it is empty, the app
# derives the MFA key from PATIENT_ENCRYPTION_KEY with HMAC-SHA-256.
# Generate with: openssl rand -base64 32
# MFA_ENCRYPTION_KEY=replace-with-a-different-32-byte-base64-key
MFA_KEY_VERSION=1

# How often the background job deletes expired and revoked sessions, expired
# MFA challenges and expired reset tokens. Default 1h, minimum 1m, maximum 24h.
SESSION_PURGE_INTERVAL=1h

# Optional: database used by the integration tests.
# TEST_DB_URL=postgres://user:password@localhost:5432/altserv_test?sslmode=disable

# Database pool limits. Keep DB_MAX_IDLE_CONNS at or below DB_MAX_OPEN_CONNS.
# Raise DB_MAX_OPEN_CONNS only after checking the PostgreSQL connection limit.
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# Time between failing readiness and closing the listener. The load balancer
# needs this window to stop sending new requests. Default 5s, maximum 5m.
SHUTDOWN_DRAIN_DELAY=5s

# Statements running longer than this count as slow in the pg_stat_activity
# sample. Default 1s, maximum 1m.
SLOW_QUERY_THRESHOLD=1s

# Optional: protect GET /metrics with a bearer token. At least 16 characters.
# Production must set this and configure Prometheus with the same value.
# METRICS_TOKEN=replace-with-a-long-random-token

# Optional: file touched by the backup job after a successful backup. The app
# exports its age as altserv_backup_age_seconds.
# BACKUP_MARKER_FILE=/var/lib/altserv/last-backup

# Used by deployments/docker/docker-compose.yml only.
# POSTGRES_USER=altserv
# POSTGRES_PASSWORD=replace-with-a-strong-password
# POSTGRES_DB=altserv
