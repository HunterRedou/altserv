# Copy to .env and fill in real values. Never commit .env.
DB_URL=postgres://user:password@localhost:5432/altserv?sslmode=disable
PLATFORM=dev
PORT=8080
# Go duration syntax. Default 24h, maximum 720h (30 days).
SESSION_DURATION=24h

# AES-256-GCM key for patient PII. Must decode to exactly 32 bytes.
# Generate with: openssl rand -base64 32
PATIENT_ENCRYPTION_KEY=replace-with-32-byte-base64-key
PATIENT_KEY_VERSION=1

# Separate HMAC-SHA256 key for the protected patient search index. Must decode
# to exactly 32 bytes and must differ from PATIENT_ENCRYPTION_KEY.
# Generate with: openssl rand -base64 32
PATIENT_SEARCH_KEY=replace-with-a-different-32-byte-base64-key
PATIENT_SEARCH_KEY_VERSION=1

# Optional: database used by the integration tests.
# TEST_DB_URL=postgres://user:password@localhost:5432/altserv_test?sslmode=disable
